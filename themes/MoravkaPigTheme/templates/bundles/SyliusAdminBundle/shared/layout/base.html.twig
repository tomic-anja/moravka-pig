{% import "@SyliusUi/macro/rtl.html.twig" as rtl %}

{% set generic_hook = 'sylius_admin.base' %}

<!DOCTYPE html>
<html lang="{{ app.request.locale }}" {{ rtl.default(sylius.localeCode) }}>
    <head>
        {% block metatags %}
            {% hook generic_hook ~ '#metatags' %}
        {% endblock %}

        <title>{% block title %}Moravka Pig{% endblock %}</title>

        {% block stylesheets %}
            {% hook generic_hook ~ '#stylesheets' %}
            <link rel="stylesheet" href="{{ asset('_themes/anja-tomic/moravka-pig-theme/assets/styles/admin.css') }}">
            <link rel="icon" href="{{ asset('_themes/anja-tomic/moravka-pig-theme/assets/images/favicon.png') }}" type="image/png" sizes="32x32">
            <link rel="shortcut icon" href="{{ asset('_themes/anja-tomic/moravka-pig-theme/assets/images/favicon.png') }}" type="image/x-icon">
            <link rel="apple-touch-icon" href="{{ asset('_themes/anja-tomic/moravka-pig-theme/assets/images/favicon.png') }}">
            <link rel="manifest" href="{{ asset('_themes/anja-tomic/moravka-pig-theme/assets/favicon.png') }}">
        {% endblock %}
    </head>
    <body class="{% block body_class %}{% endblock %}">
        <div class="page">
            {% block body %}{% endblock %}
        </div>

        {% block javascripts %}
            {% hook generic_hook ~ '#javascripts' %}
        {% endblock %}
    </body>
</html>
